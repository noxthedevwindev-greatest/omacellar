}

# ----------------------------------------------------------------- misc ----

cmd_status() {
  parse_args "$@"
  ensure_dirs

  local -a runners=() prefixes=()
  mapfile -t runners < <(runner_list_installed)
  mapfile -t prefixes < <(prefix_list)

  if [[ ${FLAG_json:-false} == true ]]; then
    json_status
    return 0
  fi

  printf '\n%somacellar%s %s\n' "$C_BOLD" "$C_RESET" "$OMACELLAR_VERSION"
  printf '%s%s%s\n\n' "$C_DIM" "$(runners_dir)" "$C_RESET"

  printf '  %srunners%s   %d installed, %s\n' "$C_BOLD" "$C_RESET" "${#runners[@]}" \
    "$(human_size "$(dir_size "$(runners_dir)")")"
  local name
  for name in "${runners[@]}"; do
    printf '    %-28s %s\n' "$name" "$(runner_meta "$name" reported_version)"
  done
  [[ ${#runners[@]} -eq 0 ]] && printf '    %snothing yet: omacellar runner add soda%s\n' "$C_DIM" "$C_RESET"

  printf '\n  %sinstallations%s %d, %s\n' "$C_BOLD" "$C_RESET" "${#prefixes[@]}" \
    "$(human_size "$(dir_size "$(prefixes_dir)")")"
  for name in "${prefixes[@]}"; do
    printf '    %-28s %s on %s\n' "$name" \
      "$(prefix_meta "$name" bitness unknown)" "$(prefix_meta "$name" runner -)"
  done
  [[ ${#prefixes[@]} -eq 0 ]] && printf '    %snone yet: omacellar prefix create default%s\n' "$C_DIM" "$C_RESET"

  printf '\n  %supdates%s\n' "$C_BOLD" "$C_RESET"
  mapfile -t pending < <(runner_update_available)
  if [[ ${#pending[@]} -eq 0 ]]; then
    printf '    %severything is current%s\n' "$C_GREEN" "$C_RESET"
  else
    local line have want
    for line in "${pending[@]}"; do
      IFS=$'\t' read -r name have want <<<"$line"
      printf '    %-28s %s -> %s\n' "$name" "$have" "$want"
    done
    printf '    %somacellar runner update --all%s\n' "$C_DIM" "$C_RESET"
  fi

  local def; def=$(config_get default_runner)
  printf '\n  %sdefault runner%s %s\n\n' "$C_BOLD" "$C_RESET" "${def:-unset}"
}

json_status() {
  local -a runners=() prefixes=() pending=()
  mapfile -t runners < <(runner_list_installed)
  mapfile -t prefixes < <(prefix_list)
  mapfile -t pending < <(runner_update_available)

  local -a ritems=() pitems=() uitems=()
  local r ver
  for r in "${runners[@]}"; do
      ritems+=("$(json_emit \
        "name" "$(json_str "$r")" \
        "id" "$(json_str "$(runner_meta "$r" id)")" \
        "version" "$(json_str "$(runner_meta "$r" version)")" \
        "kind" "$(json_str "$(runner_meta "$r" kind)")" \
        "reported_version" "$(json_str "$(runner_meta "$r" reported_version)")" \
        "source" "$(json_str "$(runner_meta "$r" source)")")")
  done

  local p
  for p in "${prefixes[@]}"; do
      pitems+=("$(json_emit \
        "name" "$(json_str "$p")" \
        "runner" "$(json_str "$(prefix_meta "$p" runner "-")")" \
        "architecture" "$(json_str "$(prefix_meta "$p" bitness unknown)")" \
        "valid" "$(json_bool "$(prefix_is_valid "$p")")")")
  done
    local line have want u
  for line in "${pending[@]}"; do
    IFS=$'\t' read -r u have want <<<"$line"
    uitems+=("$(json_emit \
      "name" "$(json_str "$u")" \
      "installed" "$(json_str "$have")" \
      "available" "$(json_str "$want")")")
  done

  ver=$(config_get channel stable)
  json_emit \
    "version" "$(json_str "$OMACELLAR_VERSION")" \
    "home" "$(json_str "$(runners_dir)")" \
    "default_runner" "$(json_str "$(config_get default_runner)")" \
    "channel" "$(json_str "$ver")" \
    "runners" "$(json_array "${ritems[@]}")" \
    "prefixes" "$(json_array "${pitems[@]}")" \
    "updates" "$(json_array "${uitems[@]}")"
}

# True when the cellar at $OMACELLAR_HOME still holds nothing but symlinks and
# metadata. migrate uses this to notice it already ran.
# True when the legacy directories still exist but hold nothing, which means a
# previous migrate already moved everything out of them.
legacy_already_drained() {
  local old=${XDG_DATA_HOME}/omacellar d
  for d in runners prefixes bottles; do
    [[ -d $old/$d ]] || continue
    # Anything left that is not a dotfile means there is work to do.
    if [[ -n $(find "$old/$d" -mindepth 1 -maxdepth 1 ! -name '.*' 2>/dev/null | head -n1) ]]; then
      return 1
    fi
  done
  return 0
}

cmd_migrate() {
  parse_args "$@"
  printf '\n%somacellar migrate%s  %s(%s -> %s)%s\n\n' \
    "$C_BOLD" "$C_RESET" "$C_DIM" "${XDG_DATA_HOME}/omacellar" "$OMACELLAR_HOME" "$C_RESET"

  local old=${XDG_DATA_HOME}/omacellar
  if [[ ! -d $old ]]; then
    log_dim "nothing at $old, nothing to migrate"
    printf '\n'
    return 0
  fi

  if legacy_already_drained; then
    log_warn "$old has already been migrated, its directories are empty"
    log_hint "is $OMACELLAR_HOME the cellar you meant to keep using?"
    printf '\n'
    return 0
  fi

  printf 'found:\n'
  local d
  for d in runners prefixes bottles; do
    [[ -d $old/$d ]] || continue
    printf '  %s  %s\n' "$old/$d" "$(human_size "$(dir_size "$old/$d")")"
  done
  printf '\n'
  log_warn "runners and prefixes will be MOVED out of $old, not copied"
  printf '\n'

  ensure_dirs

  # Legacy directory name, then where it belongs now.
  local -a what=()
  [[ -d $old/runners ]] && what+=("runners:$(runners_dir)")
  [[ -d $old/prefixes ]] && what+=("prefixes:$(prefixes_dir)")
  # An earlier draft of this tool called them bottles. Import that too.
  [[ -d $old/bottles ]] && what+=("bottles:$(prefixes_dir)")

  local pair legacy_name dst
  for pair in "${what[@]}"; do
    legacy_name=${pair%%:*}
    dst=${pair#*:}
    local src="$old/$legacy_name"
    [[ -d $src ]] || continue

    printf '%s%s%s\n' "$C_BOLD" "$legacy_name" "$C_RESET"
    local n
    n=$(find "$src" -mindepth 1 -maxdepth 1 ! -name '.*' 2>/dev/null | wc -l)
    printf '  %d item(s) to import into %s\n' "$n" "$dst"

    if [[ $ASSUME_YES != true ]]; then
      confirm "  move them?" || { printf '  skipped\n\n'; continue; }
    fi

    migrate_legacy_dir "$src" "$dst" "$legacy_name"
    printf '\n'
  done

  printf '%sanything left in %s is still there%s\n' "$C_DIM" "$old" "$C_RESET"
  printf 'when you are happy with the new cellar: rm -rf %q\n' "$old"
  printf '\n'
  return 0
}

cmd_config() {
  parse_args "$@"
  config_init
  local action=${POSITIONALS[0]:-list}
  case $action in
    list)
      printf '\n%sconfiguration%s  %s%s%s\n\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$(config_file)" "$C_RESET"
      config_load
      local key val
      for key in $CONFIG_KEYS; do
        val=${CONFIG[$key]:-}
        [[ $key == default_runner && -n $val && ! -e $(runner_dir_of "$val") ]] \
          && val="$val ${C_YELLOW}(missing)${C_RESET}"
        printf '  %-20s %s%s%s\n' "$key" "$C_CYAN" "${val:-(unset)}" "$C_RESET"
      done
      printf '\n'
      ;;
    path)
      printf '%s\n' "$(config_file)"
      ;;
    get)
      local key=${POSITIONALS[1]:-}
      [[ -n $key ]] || die "config get needs a key"
      printf '%s\n' "$(config_get "$key")"
      ;;
    set)
      local key=${POSITIONALS[1]:-} val=${POSITIONALS[2]:-}
      [[ -n $key ]] || die "config set needs a key and a value"
      config_key_known "$key" || log_warn "unknown key '$key', writing it anyway"
      config_set "$key" "$val"
      log_ok "$key = $val"
      ;;
    unset)
      local key=${POSITIONALS[1]:-}
      [[ -n $key ]] || die "config unset needs a key"
      config_unset "$key"
      log_ok "$key cleared"
      ;;
    *)
      die "unknown config action: $action (want list, get, set, unset, path)"
      ;;
  esac
}

cmd_completions() {
  parse_args "$@"
  local shell; shell=$(first_positional)
  case $shell in
    bash) cat "$OMACELLAR_ROOT/completions/omacellar.bash" ;;
    zsh) cat "$OMACELLAR_ROOT/completions/_omacellar" ;;
    fish) cat "$OMACELLAR_ROOT/completions/omacellar.fish" ;;
    *) die "unknown shell: ${shell:-<none>} (want bash, zsh or fish)" ;;
  esac
}

cmd_doctor() { parse_args "$@"; doctor_run; }

cmd_about() {
  parse_args "$@"
  ensure_dirs
  printf '\n'
  ascii_art
  printf '%somacellar%s %s\n' "$C_BOLD" "$C_RESET" "$OMACELLAR_VERSION"
  printf '%sa cellar of Windows runners%s\n\n' "$C_DIM" "$C_RESET"

  printf '%s%-14s%s %s\n' "$C_BOLD" "author" "$C_RESET" "NoxTheDev"
  printf '%s%-14s%s %s\n' "$C_BOLD" "home" "$C_RESET" "$OMACELLAR_HOME"
  printf '%s%-14s%s %s\n' "$C_BOLD" "catalogue" "$C_RESET" \
    "${OMACELLAR_HOME/#$HOME/~}/data/runner_types/runners.conf"
  printf '\n'
  printf '%sMade By NoxTheDev%s\n\n' "$C_CYAN" "$C_RESET"
}

# Flat <id>-<version> directories become <id>/New/<version>.
migrate_legacy_dir() {
  local src=$1 dst=$2 what=$3
  local e base

  for e in "$src"/*; do
    [[ -e $e ]] || continue
    base=${e##*/}
    [[ $base == .* ]] && continue

    if [[ $what == runners ]]; then
      # A linked runner is a symlink and stays one, keyed by its own name.
      if [[ -L $e ]]; then
        if [[ -e $dst/$base || -L $dst/$base ]]; then
          log_warn "  $base already exists in the new layout, skipping"
          continue
        fi
        if ! ln -sfn "$(readlink -f "$e")" "$dst/$base"; then
          log_warn "  could not relink $base, leaving it at $e"
          continue
        fi
        # Legacy linked runners kept metadata in a side directory.
        local legacy="$src/.omacellar-meta/$base.json"
        if [[ -f $legacy ]]; then
          mkdir -p "$dst/.omacellar-meta"
          cp "$legacy" "$dst/.omacellar-meta/$base.json"
        fi
        printf '  linked  %s -> %s\n' "$base" "$(readlink -f "$e")"
        continue
      fi

      # Split "<id>-<version>" by asking the runner registry, not by counting
      # dashes: soda-dev and kron4ek-tkg both contain them.
      local id version
      if ! id=$(runner_infer_id "$base"); then
        log_warn "  cannot tell which runner '$base' is, leaving it alone"
        log_hint "move it by hand into $dst/<id>/New/<version>, or use runner link"
        continue
      fi
      version=${base#"$id"-}
      if [[ $version == "$base" || -z $version ]]; then
        log_warn "  '$base' does not end in a version, leaving it alone"
        continue
      fi

      mkdir -p "$dst/$id/New"
      if [[ -e $dst/$id/New/$version ]]; then
        log_warn "  $id $version already exists in the new layout, skipping"
        continue
      fi
      mv "$e" "$dst/$id/New/$version"
      printf '  moved   %s -> runners/%s/New/%s\n' "$base" "$id" "$version"
    else
      # Legacy bottles/ and prefixes/ both land in prefixes/.
      if [[ -e $dst/$base ]]; then
        log_warn "  $base already exists in the new layout, skipping"
        continue
      fi
      mv "$e" "$dst/$base"

      # The metadata records the absolute prefix directory, which just changed
      # under it. Fix that, and repoint anything inside dosdevices that pointed
      # at the old location. Wine itself keeps no absolute cellar paths in
      # system.reg, but dosdevices entries can be absolute if a runner wrote
      # them that way.
      local meta="$dst/$base/.omacellar.json" kind winedir
      if [[ -f $meta ]]; then
        kind=$(jq -r '.kind // "wine"' "$meta" 2>/dev/null)
        if [[ $kind == proton ]]; then
          winedir="$dst/$base/pfx"
        else
          winedir="$dst/$base"
        fi
        local tmp; tmp=$(mktemp)
        if jq --arg d "$winedir" '.prefix_dir = $d' "$meta" >"$tmp" 2>/dev/null; then
          mv -f "$tmp" "$meta"
          printf '    %s\n' "prefix_dir -> $winedir"
        else
          rm -f "$tmp"
          log_warn "  could not update $base/.omacellar.json"
        fi
      fi

      # dosdevices/c: and friends are usually relative, but a runner that wrote
      # absolute ones would silently point into the old cellar.
      local link
      for link in "$dst/$base"/dosdevices/*; do
        [[ -L $link ]] || continue
        local target; target=$(readlink "$link")
        [[ $target == /* ]] || continue
        if [[ $target == "$src/$base/"* ]]; then
          ln -sfn "${target/"$src/$base"/$dst/$base}" "$link"
          log_dim "    repointed ${link##*/} to the new location"
        fi
      done

      printf '  moved   %s -> prefixes/%s\n' "$base" "$base"
    fi
  done

  runner_index_build
  return 0
}

cmd_version() {
  printf 'omacellar %s\n' "$OMACELLAR_VERSION"
}

cmd_help() {
  local topic=${1:-}
  case $topic in
    runner | runners) runner_usage ;;
    prefix | prefixes) prefix_usage ;;
    "") usage ;;
    *) usage ;;
  esac
}

# ------------------------------------------------------------------ main ----

dispatch_runner() {
  local sub=${1:-list}
  shift || true
  case $sub in
    list | ls) cmd_runner_list "$@" ;;
    search | find) cmd_runner_search "$@" ;;
    info | show) cmd_runner_info "$@" ;;
    available | versions) cmd_runner_available "$@" ;;
    add | install) cmd_runner_add "$@" ;;
    remove | rm | uninstall) cmd_runner_remove "$@" ;;
    update | upgrade) cmd_runner_update "$@" ;;
    link) cmd_runner_link "$@" ;;
    unlink) cmd_runner_unlink "$@" ;;
    adopt) cmd_runner_adopt "$@" ;;
    path) cmd_runner_path "$@" ;;
    steam) cmd_runner_steam "$@" ;;
    unsteam) cmd_runner_unsteam "$@" ;;
    exec) cmd_runner_exec "$@" ;;
    old | kept) cmd_runner_old "$@" ;;
    activate | use) cmd_runner_activate "$@" ;;
    -h | --help | help) runner_usage ;;
    *) die "unknown runner subcommand: $sub (try: omacellar help runner)" ;;
  esac
}

dispatch_prefix() {
  local sub=${1:-list}
  shift || true
  case $sub in
    list | ls) cmd_prefix_list "$@" ;;
    create | new | add) cmd_prefix_create "$@" ;;
    remove | rm | delete) cmd_prefix_remove "$@" ;;
    info | show) cmd_prefix_info "$@" ;;
    path) cmd_prefix_path "$@" ;;
    run) cmd_prefix_run "$@" ;;
    shell) cmd_prefix_shell "$@" ;;
    winetricks | wt) cmd_prefix_winetricks "$@" ;;
    env) cmd_prefix_env "$@" ;;
    -h | --help | help) prefix_usage ;;
    *) die "unknown prefix subcommand: $sub (try: omacellar help prefix)" ;;
  esac
}

main() {
  (( $# == 0 )) && { usage; exit 0; }

  local group=$1
  shift

  case $(normalise_group "$group") in
    runner)
      if [[ ${1:-} == -h || ${1:-} == --help || ${1:-} == help ]]; then
        runner_usage
        return 0
      fi
      dispatch_runner "$@"
      ;;
    prefix)
      if [[ ${1:-} == -h || ${1:-} == --help || ${1:-} == help ]]; then
        prefix_usage
        return 0
      fi
      dispatch_prefix "$@"
      ;;
    doctor | check) cmd_doctor "$@" ;;
    status | stat) cmd_status "$@" ;;
    about | credits) cmd_about "$@" ;;
    migrate) cmd_migrate "$@" ;;
    config) cmd_config "$@" ;;
    completions) cmd_completions "$@" ;;
    version | --version | -V) cmd_version "$@" ;;
    help | --help | -h) cmd_help "$@" ;;
    *)
      die "unknown command: $group (try: omacellar help)"
      ;;
  esac
}

main "$@"