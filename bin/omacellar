#!/usr/bin/env bash
#
# omacellar - a cellar of Windows runners
#
# Install, update and juggle Wine builds (Soda, Caffe, Vaniglia, McSoda,
# Proton builds, Wine-GE, GE-Proton, tkg) and the installations that run on
# them. Command line only, no daemon, no GUI.

set -euo pipefail

OMACELLAR_SELF=${BASH_SOURCE[0]}
while [[ -L $OMACELLAR_SELF ]]; do
  _d=$(cd -P "$(dirname "$OMACELLAR_SELF")" && pwd)
  OMACELLAR_SELF=$(readlink "$OMACELLAR_SELF")
  [[ $OMACELLAR_SELF != /* ]] && OMACELLAR_SELF=$_d/$OMACELLAR_SELF
done
OMACELLAR_BIN_DIR=$(cd -P "$(dirname "$OMACELLAR_SELF")" && pwd)

if [[ -z ${OMACELLAR_ROOT:-} ]]; then
  for _candidate in \
    "$OMACELLAR_BIN_DIR/.." \
    "$(dirname "$OMACELLAR_BIN_DIR")/share/omacellar" \
    "/usr/share/omacellar"; do
    if [[ -f "$_candidate/lib/core.sh" ]]; then
      OMACELLAR_ROOT=$(cd -P "$_candidate" && pwd)
      break
    fi
  done
  unset _candidate
fi

if [[ -z ${OMACELLAR_ROOT:-} || ! -f $OMACELLAR_ROOT/lib/core.sh ]]; then
  printf 'omacellar: cannot find its libraries.\n' >&2
  printf 'Looked next to the executable and in /usr/share/omacellar.\n' >&2
  printf 'Set OMACELLAR_ROOT to the directory holding lib/ and registry/.\n' >&2
  exit 1
fi
export OMACELLAR_ROOT

for _m in core registry install launch prefix update ui doctor; do
  # shellcheck source=/dev/null
  source "$OMACELLAR_ROOT/lib/$_m.sh"
done
unset _m

runner_index_build

# ------------------------------------------------------------- arguments ----

declare -a POSITIONALS=()
ASSUME_YES=${OMACELLAR_ASSUME_YES:-false}
REFRESH_API=false
NO_COLOR_ARG=false

VALUE_FLAGS="runner arch as channel sort"

parse_args() {
  parse_args_until 0 "$@"
}

parse_args_until() {
  local stop_after=$1; shift
  POSITIONALS=()
  local seen=0
  while (( $# )); do
    if (( stop_after > 0 && seen >= stop_after )); then
      POSITIONALS+=("$@")
      break
    fi
    case $1 in
      --)
        shift
        POSITIONALS+=("$@")
        break
        ;;
      --*=*)
        local k=${1%%=*} v=${1#*=}
        k=${k#--}
        set_flag "$k" "$v"
        ;;
      --no-*)
        set_flag "${1#--no-}" false
        ;;
      --*)
        local name=${1#--}
        if [[ " $VALUE_FLAGS " == *" $name "* ]]; then
          [[ $# -ge 2 ]] || die "--$name needs a value"
          set_flag "$name" "$2"
          shift
        else
          set_flag "$name" true
        fi
        ;;
      -y)
        ASSUME_YES=true
        ;;
      -f)
        set_flag force true
        ;;
      -a | --all)
        set_flag all true
        ;;
      -h | --help)
        set_flag help true
        ;;
      -V | --version)
        set_flag version true
        ;;
      -?*)
        die "unknown option: $1"
        ;;
      *)
        POSITIONALS+=("$1")
        seen=$(( seen + 1 ))
        ;;
    esac
    shift
  done
}

set_flag() {
  local name=$1 value=$2
  # --dry-run and --dry_run both land in FLAG_dry_run.
  name=${name//-/_}
  case $name in
    yes) ASSUME_YES=$value ;;
    refresh) REFRESH_API=$value ;;
    help) FLAG_HELP=$value ;;
    version) FLAG_VERSION=$value ;;
    *) printf -v "FLAG_$name" '%s' "$value" ;;
  esac
}

flag() { printf '%s\n' "${!1:-}"; }

normalise_group() {
  case $1 in
    runner | runners | r) printf 'runner\n' ;;
    prefix | prefixes | p) printf 'prefix\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

first_positional() { printf '%s\n' "${POSITIONALS[0]:-}"; }
second_positional() { printf '%s\n' "${POSITIONALS[1]:-}"; }

# ------------------------------------------------------------------ help ----

usage() {
  cat <<EOF
${C_BOLD}omacellar${C_RESET} $OMACELLAR_VERSION - a cellar of Windows runners

${C_BOLD}usage${C_RESET}
  omacellar <command> [subcommand] [options]

${C_BOLD}runners${C_RESET}
  runner list                 installed runners and what upstream offers
  runner search <text>        find runners by name or description
  runner info <name>          everything known about one runner
  runner available <id>       every published version of a runner
  runner add <id>[@version]   download and install a runner
  runner remove <name>        uninstall a runner
  runner update [name|--all]  fetch newer builds
  runner link <path>          adopt a runner directory already on disk
  runner unlink <name>        forget a linked runner
  runner adopt                register untracked runner directories
  runner path <name>          print where a runner lives
  runner steam <name>         register a Proton runner with Steam
  runner unsteam <name>       undo that
  runner exec <name> <cmd>    run a command inside a runner
  runner old                  versions kept in Old/
  runner activate <id>[@ver]  make a kept version the active one

${C_BOLD}installations${C_RESET}
  prefix list                     list installations
  prefix create <name>            new installation
  prefix remove <name>            delete an installation
  prefix info <name>              what is inside an installation
  prefix path <name>              print an installation path
  prefix run <name> <program>     run a program in an installation
  prefix shell <name> [terminal]  a terminal with the environment ready
  prefix winetricks <name> [verb] run winetricks against an installation
  prefix env <name>               shell exports, for eval

${C_BOLD}the rest${C_RESET}
  status              one screen summary
  about               who made this
  doctor              check the machine for problems
  migrate             adopt a cellar from an older ~/.local/share/omacellar
  config <get|set>    read and write configuration
  completions <shell> bash, zsh or fish
  help [command]      this text, or the long form
  version             print the version

${C_BOLD}examples${C_RESET}
  omacellar runner add soda
  omacellar runner add protosoda
  omacellar prefix create games --runner soda --arch both
  omacellar prefix run games 'C:\\Program Files\\Some Game\\game.exe'
  omacellar runner update --all --check
EOF
}

runner_usage() {
  cat <<EOF
${C_BOLD}omacellar runner${C_RESET} - manage the runners themselves

  list [--installed|--available] [--all] [--refresh] [--json]
      Installed runners with sizes and reported versions, plus the newest
      version each registry entry currently offers.

      --json prints one object with "installed" and "available" arrays instead
      of tables, for scripting. Same on `status`, `prefix list` and
      `runner info`.

  search <text>
      Match against runner ids, titles and descriptions.

  info <name|id> [--json]
      Version, kind, source, upstream and what else is available.

  available <id>
      Every version the publisher has released, newest first.

  add <id>[@version] [--force] [--yes] [--dry-run]
      Resolve, download, verify, unpack and register a runner.
      --force reinstalls a version that is already present.
      --dry-run resolves and reports what would happen, downloading nothing.

  remove <name> [--yes]
      Delete an installed runner. Linked runners are unlinked, not deleted.

  update [name|--all] [--check] [--yes]
      Compare installed versions with upstream. --check only reports.
      Updates by bare id, so 'runner update soda' works.

  link <path> [--as <id>]
      Register a runner directory that already exists. Nothing is copied.

  unlink <name>
      Forget a linked runner, leaving its files alone.

  old [--json]
      Versions kept in runners/<id>/Old/. Updating replaces the active version
      and moves the outgoing one here.

  adopt
      Give metadata to runner directories omacellar does not know yet, so an
      existing collection becomes manageable.

  old [--json]
      Versions kept in runners/<id>/Old/. Updating replaces the active version
      and moves the outgoing one here.

  activate <id>[@version]
      Make a kept version active again. Whatever is active now is parked in
      Old/ under its own version, so nothing is lost. Without a version, the
      newest kept one wins.

  path <name>
      Print the install directory.

  steam <name>
      Register a Proton runner with Steam's compatibilitytools.d, so it shows
      up as a compatibility choice. Automatic on install, this redoes it.

  unsteam <name>
      Remove that registration again.

  exec <name> <command> [args...]
      Run a command with the runner on PATH and no prefix attached.
EOF
}

prefix_usage() {
  cat <<EOF
${C_BOLD}omacellar prefix${C_RESET} - manage installations

  list
      Name, runner, architecture and size of every installation.

  create <name> [--runner <name|id>] [--arch win64|win32|both] [--force]
                  [--yes] [--no-update-check]
      Create an installation and boot it once so it is usable.
      Without --runner the configured default_runner is used, otherwise the
      newest runner in the cellar.

      If the chosen runner has a newer build published, you are asked whether
      to update first. --yes takes the update without asking; with no terminal
      and no --yes the installed version is used as-is.

      win64  64-bit prefix, and 32-bit programs run in it too (default)
      both   same as win64 on Wine 10 and newer, which is every runner here
      win32  a pure 32-bit prefix, only possible on runners that ship 32-bit
             libraries, and only at creation time

  remove <name> [--yes]
      Delete an installation and everything installed into it.

  info <name>
      Runner, architecture, created date, size and the runners it can use.

  path <name>
      Print the installation directory.

  run <name> <program> [args...] [--no-fix]
      Run a program. The program may be a Windows path, a path relative to
      the installation, or a path on disk.
      A prefix with a recognisable problem is reported and offered a fix
      before launching. --no-fix skips that.

  shell <name> [terminal]
      Open a terminal with WINEPREFIX and the runner already exported.

  winetricks <name> [verb...]
      Run winetricks against the installation. No verb opens the GUI.

  env <name>
      Print exports, so you can do: eval "\$(omacellar prefix env games)"
EOF
}

# ---------------------------------------------------------------- runner ----

cmd_runner_list() {
  parse_args "$@"
  local show_installed=${FLAG_installed:-false}
  local show_available=${FLAG_available:-false}
  if [[ $show_installed == false && $show_available == false ]]; then
    show_installed=true
    show_available=true
  fi

  ensure_dirs

  local -a names=()
  mapfile -t names < <(runner_list_installed)

  if [[ ${FLAG_json:-false} == true ]]; then
    json_runner_list "$show_available"
    return $?
  fi

  if [[ $show_installed == true ]]; then
    printf '\n%sinstalled%s\n' "$C_BOLD" "$C_RESET"
    if [[ ${#names[@]} -eq 0 ]]; then
      log_dim "  nothing yet. omacellar runner add soda"
    else
      ui_reset
      ui_row "$(ui_dim "")" "$(ui_dim NAME)" "$(ui_dim ID)" "$(ui_dim VERSION)" "$(ui_dim KIND)" "$(ui_dim SIZE)" "$(ui_dim "RUNNER SAYS")" "$(ui_dim STEAM)"
      local name
      for name in "${names[@]}"; do
        ui_row \
          "$(ui_paint ok)" \
          "$name" \
          "$(runner_meta "$name" id)" \
          "$(runner_meta "$name" version)" \
          "$(runner_meta "$name" kind)" \
          "$(runner_size_label "$name")" \
          "$(runner_meta "$name" reported_version)" \
          "$(ui_paint "$(runner_steam_label "$name")")"
      done
      ui_table
    fi
  fi

  if [[ $show_available == true ]]; then
    printf '\n%savailable upstream%s\n' "$C_BOLD" "$C_RESET"
    collect_available
    ui_reset
    local any=false
    ui_row "$(ui_dim ID)" "$(ui_dim TITLE)" "$(ui_dim LATEST)" "$(ui_dim KIND)" "$(ui_dim CHANNEL)" "$(ui_dim INSTALLED)"
    local id latest kind ch
    for id in $(printf '%s\n' "${!AVAILABLE[@]}" | sort); do
      IFS=$'\t' read -r latest kind ch <<<"${AVAILABLE[$id]}"
      any=true
      ui_row "$id" "$(reg_title "$id")" "$latest" "$kind" "$(ui_paint "$ch")" \
        "$(runner_installed_summary "$id")"
    done
    if [[ $any == true ]]; then
      ui_table
    else
      log_dim "  no runners resolved. check network access, or export GITHUB_TOKEN"
    fi
  fi
  printf '\n'
  return 0
}



declare -A AVAILABLE=()

# Walks the registry and fills AVAILABLE[id] with "latest<TAB>kind<TAB>channel".
# Shared by the human table and the --json path so both agree on what upstream
# currently offers.
collect_available() {
  AVAILABLE=()
  registry_load
  local channel; channel=$(config_get channel stable)
  local id latest_ver kind ch
  for id in "${REG_IDS[@]}"; do
    ch=$(reg_channel "$id")
    [[ -z $ch || $ch == "-" ]] && continue
    if [[ -z ${FLAG_all:-} && $ch != "$channel" ]]; then
      continue
    fi
    reg_supports_host "$id" || continue
    latest_ver=$(runner_latest_version "$id" 2>/dev/null | cut -f1)
    [[ -n $latest_ver ]] || continue
    kind=$(reg_kind "$id")
    AVAILABLE[$id]="$latest_ver"$'\t'"$kind"$'\t'"$ch"
  done
}

json_runner_list() {
  local want_available=${1:-false}
  AVAILABLE=()
  if [[ $want_available == true ]]; then
    collect_available
  fi
  local -a names=()
  mapfile -t names < <(runner_list_installed)

  local -a items=()
  local name
  for name in "${names[@]}"; do
    items+=("$(json_emit \
      "name" "$(json_str "$name")" \
      "id" "$(json_str "$(runner_meta "$name" id)")" \
      "version" "$(json_str "$(runner_meta "$name" version)")" \
      "kind" "$(json_str "$(runner_meta "$name" kind)")" \
      "reported_version" "$(json_str "$(runner_meta "$name" reported_version)")" \
      "source" "$(json_str "$(runner_meta "$name" source)")" \
      "size_bytes" "$(dir_size "$(runner_dir_of "$name")" 2>/dev/null || echo 0)" \
      "path" "$(json_str "$(runner_dir_of "$name")")" \
      "steam" "$(json_str "$(runner_steam_label "$name")")")")
  done

  local -a avail=()
  local id
  for id in "${!AVAILABLE[@]}"; do
    IFS=$'\t' read -r latest kind ch <<<"${AVAILABLE[$id]}"
    avail+=("$(json_emit \
      "id" "$(json_str "$id")" \
      "title" "$(json_str "$(reg_title "$id")")" \
      "latest" "$(json_str "$latest")" \
      "kind" "$(json_str "$kind")" \
      "channel" "$(json_str "$ch")" \
      "installed" "$(json_str "$(runner_installed_summary "$id")")")")
  done

  json_emit \
    "home" "$(json_str "$(runners_dir)")" \
    "installed" "$(json_array "${items[@]}")" \
    "available" "$(json_array "${avail[@]}")"
}

runner_installed_summary() {
  local id=$1 name out= ver
  while IFS= read -r name; do
    [[ $(runner_meta "$name" id) == "$id" ]] || continue
    ver=$(runner_meta "$name" version)
    [[ ${#ver} -gt 22 ]] && ver="${ver:0:21}~"
    out+="${out:+, }$ver"
  done < <(runner_list_installed)
  printf '%s\n' "${out:--}"
}

cmd_runner_search() {
  parse_args "$@"
  local q; q=$(first_positional)
  [[ -n $q ]] || die "runner search needs something to search for"
  registry_load

  local id title desc found=false
  ui_reset
  for id in "${REG_IDS[@]}"; do
    title=$(reg_title "$id")
    desc=$(reg_desc "$id")
    if [[ ${id,,} == *"${q,,}"* || ${title,,} == *"${q,,}"* || ${desc,,} == *"${q,,}"* ]]; then
      found=true
      ui_row "$id" "$title" "$(reg_kind "$id")" "$(ui_paint "$(reg_channel "$id")")" "$desc"
    fi
  done

  local name
  while IFS= read -r name; do
    [[ ${name,,} == *"${q,,}"* ]] || continue
    reg_exists "$(runner_meta "$name" id)" && continue
    found=true
    ui_row "$name" "$(runner_meta "$name" id)" "$(runner_meta "$name" kind)" "$(ui_paint local)" "installed, not in the registry"
  done < <(runner_list_installed)

  if [[ $found == true ]]; then
    ui_table
    printf '\n'
  else
    log_dim "nothing matches '$q'"
    log_hint "try a broader word, or: omacellar runner list"
  fi
}

cmd_runner_info() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner info needs a name"

  if [[ ${FLAG_json:-false} == true ]]; then
    json_runner_info "$name"
    return $?
  fi

  local id installed=false src=
  if runner_installed "$name"; then
    installed=true
    id=$(runner_meta "$name" id)
  else
    id=$name
    if ! reg_exists "$id"; then
      local guessed; guessed=$(runner_infer_id "$name" 2>/dev/null || true)
      [[ -n $guessed ]] && id=$guessed
    fi
  fi

  reg_exists "$id" || die "unknown runner: $name"
  [[ $installed == true ]] || log_dim "$name is not installed"

  local ver latest=
  if [[ $installed == true ]]; then
    ver=$(runner_meta "$name" version)
    src=$(runner_meta "$name" source)
    latest=$(runner_latest_version "$id" 2>/dev/null | cut -f1 || true)
  else
    latest=$(runner_latest_version "$id" 2>/dev/null | cut -f1 || true)
    ver=$latest
  fi

  if [[ ${FLAG_json:-false} == true ]]; then
    json_prefix_info "$name"
    return 0
  fi

  printf '\n%s%s%s  %s(%s)%s\n\n' "$C_BOLD" "$(reg_title "$id")" "$C_RESET" "$C_DIM" "$id" "$C_RESET"
  printf '  %s\n\n' "$(reg_desc "$id")"

  local -a kv=(
    "kind" "$(reg_kind "$id")"
    "channel" "$(reg_channel "$id")"
    "installs for" "$(reg_arches "$id")"
  )
  [[ -n $ver ]] && kv+=("version" "$ver")
  [[ $(reg_repo "$id") != "-" ]] && kv+=("upstream" "$(reg_repo "$id")")
  [[ -n $(reg_homepage "$id") ]] && kv+=("homepage" "$(reg_homepage "$id")")
  if [[ $installed == true ]]; then
    kv+=("installed as" "$name")
    kv+=("path" "$(runner_dir_of "$name")")
    kv+=("size" "$(human_size "$(dir_size "$(runner_dir_of "$name")")")")
    kv+=("reports itself" "$(runner_meta "$name" reported_version)")
    kv+=("origin" "$src")
    if [[ $src == local ]]; then
      kv+=("linked to" "$(readlink -f "$(runner_dir_of "$name")")")
    fi
    if [[ $(reg_kind "$id") == proton ]]; then
      kv+=("steam" "$(runner_steam_label "$name")")
    fi
  fi
  ui_kv "${kv[@]}"

  if [[ $installed == true && -n $latest && $src != local && $src != adopted ]]; then
    printf '\n'
    if version_gt "$latest" "$ver"; then
      printf '  %supdate available: %s -> %s%s\n' "$C_YELLOW" "$ver" "$latest" "$C_RESET"
    else
      printf '  %sup to date%s\n' "$C_GREEN" "$C_RESET"
    fi
  fi

  local same=""
  while IFS= read -r same; do
    [[ $same == "$name" ]] && continue
    [[ $(runner_meta "$same" id) == "$id" ]] || continue
    printf '  also installed: %s (%s)\n' "$same" "$(runner_meta "$same" version)"
  done < <(runner_list_installed)
  printf '\n'
}

json_runner_info() {
  local name=$1 id installed=false
  if runner_installed "$name"; then
    installed=true
    id=$(runner_meta "$name" id)
  else
    id=$name
    if ! reg_exists "$id"; then
      local guessed; guessed=$(runner_infer_id "$name" 2>/dev/null || true)
      [[ -n $guessed ]] && id=$guessed
    fi
  fi
  reg_exists "$id" || die "unknown runner: $name"

  local ver= src=
  if [[ $installed == true ]]; then
    ver=$(runner_meta "$name" version)
    src=$(runner_meta "$name" source)
  else
    ver=$(runner_latest_version "$id" 2>/dev/null | cut -f1 || true)
  fi
  local latest; latest=$(runner_latest_version "$id" 2>/dev/null | cut -f1 || true)

  json_emit \
    "id" "$(json_str "$id")" \
    "title" "$(json_str "$(reg_title "$id")")" \
    "description" "$(json_str "$(reg_desc "$id")")" \
    "kind" "$(json_str "$(reg_kind "$id")")" \
    "channel" "$(json_str "$(reg_channel "$id")")" \
    "repo" "$(json_str "$(reg_repo "$id")")" \
    "homepage" "$(json_str "$(reg_homepage "$id")")" \
    "version" "$(json_str "$ver")" \
    "latest_version" "$(json_str "$latest")" \
    "installed" "$(json_bool "$installed")" \
    "installed_as" "$(json_str "${installed:+$name}")" \
    "source" "$(json_str "${src:-}")" \
    "reported_version" "$(json_str "$(
      [[ $installed == true ]] && runner_meta "$name" reported_version
    )")" \
    "path" "$(json_str "$(
      [[ $installed == true ]] && runner_dir_of "$name"
    )")"
}

cmd_runner_available() {
  parse_args "$@"
  local id; id=$(first_positional)
  [[ -n $id ]] || die "runner available needs a runner id"
  reg_exists "$id" || die "unknown runner: $id"
  reg_supports_host "$id" || die "$id is not published for $(host_arch)"

  printf '\n%s%s versions%s\n\n' "$C_BOLD" "$(reg_title "$id")" "$C_RESET"
  local ver tag installed=no
  ui_reset
  ui_row "$(ui_dim VERSION)" "$(ui_dim TAG)" "$(ui_dim INSTALLED)"
  while IFS=$'\t' read -r ver tag; do
    [[ -n $ver ]] || continue
    installed=no
    if [[ -d $(runner_dir_of "$id-$ver") ]]; then installed=yes; fi
    ui_row "$ver" "$tag" "$(ui_paint "$installed")"
  done < <(runner_versions "$id")
  ui_table
  printf '\n  install one with: omacellar runner add %s@<version>\n\n' "$id"
}

cmd_runner_add() {
  parse_args "$@"
  local spec; spec=$(first_positional)
  [[ -n $spec ]] || die "runner add needs a runner id, e.g. omacellar runner add soda"

  local id version
  IFS=$'\t' read -r id version <<<"$(split_spec "$spec")"

  if ! reg_exists "$id"; then
    log_err "unknown runner: $id"
    registry_load
    log_hint "known runners: ${REG_IDS[*]}"
    log_hint "search: omacellar runner search <text>"
    return 1
  fi

  ensure_dirs
  if [[ -n ${FLAG_steam:-} ]]; then
    [[ ${FLAG_steam} == false ]] && config_set steam_compat_tools false
  fi
  if [[ -n ${FLAG_dry_run:-} ]]; then
    DRY_RUN=${FLAG_dry_run}
    export DRY_RUN
  fi

  # --insecure means "I looked at the digest and I accept it anyway".
  if [[ -n ${FLAG_insecure:-} ]]; then
    ALLOW_BAD_SHA=${FLAG_insecure}
    export ALLOW_BAD_SHA
  fi

  local name
  name=$(with_lock runner_install "$id" "$version" "${FLAG_force:-false}")
  [[ -n $name ]] || return 1

  if [[ ${DRY_RUN:-false} == true ]]; then
    return 0
  fi

  if [[ -z $(config_get default_runner) ]]; then
    config_set default_runner "$name"
    log_hint "default_runner is now '$name'"
  fi
}

cmd_runner_remove() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner remove needs a name"
  if ! runner_installed "$name"; then
    log_err "no such runner: $name"
    log_hint "installed: $(runner_list_installed | tr '\n' ' ')"
    return 1
  fi
  runner_uninstall "$name" "$ASSUME_YES"
}

cmd_runner_update() {
  parse_args "$@"
  local target; target=$(first_positional)
  [[ -n $target ]] || target=--all

  if [[ $target != --all ]]; then
    local resolved
    if resolved=$(runner_resolve_name "$target"); then
      target=$resolved
    else
      log_err "no such runner: $target"
      log_hint "installed: $(runner_list_installed | tr '\n' ' ')"
      return 1
    fi
  fi

  runner_update "$target" "${FLAG_check:-false}" "$ASSUME_YES"
  printf '\n'
}

cmd_runner_link() {
  parse_args "$@"
  local path; path=$(first_positional)
  [[ -n $path ]] || die "runner link needs a directory"
  ensure_dirs
  local name; name=$(runner_link "$path" "$(flag FLAG_as)")
  [[ -n $name ]] && printf '%s\n' "$name"
}

cmd_runner_unlink() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner unlink needs a name"
  runner_unlink "$name"
}

cmd_runner_adopt() {
  parse_args "$@"
  ensure_dirs
  runner_adopt
}

cmd_runner_steam() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner steam needs a name"
  runner_installed "$name" || die "no such runner: $name"
  if [[ $(runner_kind_of "$name") != proton ]]; then
    log_err "$name is a Wine runner, Steam has no use for it"
    log_hint "Steam compatibility tools have to be Proton style"
    return 1
  fi
  runner_register_steam "$name" || {
    log_err "no Steam installation found"
    log_hint "set STEAM_COMPAT_TOOLS_ROOT if Steam lives somewhere unusual"
    return 1
  }
}

cmd_runner_unsteam() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner unsteam needs a name"
  runner_unregister_steam "$name"
  log_ok "unregistered $name from Steam"
}

cmd_runner_path() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner path needs a name"
  runner_installed "$name" || die "no such runner: $name"
  local dir; dir=$(runner_dir_of "$name")
  dir=$(cd -P "$dir" 2>/dev/null && pwd || printf '%s\n' "$dir")
  printf '%s\n' "$dir"
}

cmd_runner_old() {
  parse_args "$@"
  ensure_dirs
  local -a olds=()
  mapfile -t olds < <(runner_list_old)

  if [[ ${FLAG_json:-false} == true ]]; then
    local -a items=()
    local line id ver
    for line in "${olds[@]}"; do
      IFS=$'\t' read -r id ver <<<"$line"
      items+=("$(json_emit \
        "id" "$(json_str "$id")" \
        "version" "$(json_str "$ver")" \
        "path" "$(json_str "$(runner_old_path_of "$id" "$ver")")" \
        "size_bytes" "$(dir_size "$(runner_old_path_of "$id" "$ver")")")")
    done
    json_emit "kept" "$(json_array "${items[@]}")"
    return 0
  fi

  printf '\n%skept versions%s\n' "$C_BOLD" "$C_RESET"
  if [[ ${#olds[@]} -eq 0 ]]; then
    log_dim "  nothing kept, updates replace the active version unless keep_versions=true"
    printf '\n'
    return 0
  fi
  ui_reset
  ui_row "$(ui_dim "")" "$(ui_dim ID)" "$(ui_dim VERSION)" "$(ui_dim SIZE)"
  local line id ver
  for line in "${olds[@]}"; do
    IFS=$'\t' read -r id ver <<<"$line"
    ui_row "$(ui_paint ok)" "$id" "$ver" \
      "$(human_size "$(dir_size "$(runner_old_path_of "$id" "$ver")")")"
  done
  ui_table
  printf '\n  activate one with: omacellar runner activate <id>@<version>\n\n'
}

cmd_runner_activate() {
  parse_args "$@"
  local spec; spec=$(first_positional)
  [[ -n $spec ]] || die "runner activate needs <id>[@<version>]"

  local id version
  IFS=$'\t' read -r id version <<<"$(split_spec "$spec")"

  # With no version, activate the newest thing kept in Old/.
  local oldroot
  if [[ -n $version ]]; then
    oldroot="$(runners_dir)/$id/Old/$version"
  else
    oldroot=''
    local d
    for d in "$(runners_dir)/$id/Old"/*/; do
      [[ -d $d ]] || continue
      d=${d%/}
      [[ -z $oldroot ]] || version_gt "${d##*/}" "${oldroot##*/}" || continue
      oldroot=$d
    done
    [[ -n $oldroot ]] || { log_err "$id has no kept versions to activate"; return 1; }
    version=${oldroot##*/}
  fi

  [[ -d $oldroot ]] || {
    log_err "$id $version is not kept in Old/"
    log_hint "kept: $(runner_list_old | tr '\n' ' ')"
    return 1
  }

  ensure_dirs
  local newroot; newroot="$(runner_new_dir_of "$id")"
  mkdir -p "$newroot"

  # Whatever is active goes back to Old/ under its own version, so nothing is
  # lost by swapping.
  local d parked=
  for d in "$newroot"/*/; do
    [[ -d $d ]] || continue
    d=${d%/}
    parked=${d##*/}
    break
  done

  if [[ -n $parked ]]; then
    local to; to="$(runner_old_dir_of "$id")/$parked"
    if [[ -e $to ]]; then
      log_warn "$parked is already kept in Old/, replacing that copy"
      safe_remove "$to"
    fi
    mv "$newroot/$parked" "$to"
    log_dim "  parked $parked in Old/"
  fi

  mv "$oldroot" "$newroot/$version" || {
    log_err "could not activate $version"
    return 1
  }
  runner_index_build
  log_ok "$id $version is now active"
  log_hint "any prefix still pinned to an older version keeps using it"
}

cmd_runner_exec() {
  parse_args_until 1 "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "runner exec needs a runner name"
  local -a cmd=("${POSITIONALS[@]:1}")
  [[ ${#cmd[@]} -gt 0 ]] || die "runner exec needs a command to run"
  runner_installed "$name" || die "no such runner: $name"
  launch_run "$name" "" direct "${cmd[@]}"
}

# ---------------------------------------------------------------- prefix ----

cmd_prefix_list() {
  parse_args "$@"
  ensure_dirs

  local -a names=()
  mapfile -t names < <(prefix_list)

  if [[ ${FLAG_json:-false} == true ]]; then
    json_prefix_list
    return 0
  fi

  printf '\n%sinstallations%s\n' "$C_BOLD" "$C_RESET"

  if [[ ${#names[@]} -eq 0 ]]; then
    log_dim "  none yet. omacellar prefix create default --runner soda"
    printf '\n'
    return 0
  fi

  local name runner arch size
  ui_reset
  ui_row "$(ui_dim "")" "$(ui_dim NAME)" "$(ui_dim RUNNER)" "$(ui_dim ARCHITECTURE)" "$(ui_dim SIZE)"
  for name in "${names[@]}"; do
    runner=$(prefix_meta "$name" runner "-")
    arch=$(prefix_meta "$name" bitness unknown)
    size=$(human_size "$(dir_size "$(prefix_path "$name")")")
    if prefix_exists "$name"; then
      ui_row "$(ui_paint ok)" "$name" "$runner" "$(ui_paint "$arch")" "$size"
    else
      ui_row "$(ui_paint broken)" "$name" "$runner" "$arch" "$size"
    fi
  done
  ui_table
  printf '\n'
}

json_prefix_list() {
  local -a names=()
  mapfile -t names < <(prefix_list)
  local -a items=()
  local name
  for name in "${names[@]}"; do
    items+=("$(json_emit \
      "name" "$(json_str "$name")" \
      "runner" "$(json_str "$(prefix_meta "$name" runner "-")")" \
      "kind" "$(json_str "$(prefix_meta "$name" kind wine)")" \
      "architecture" "$(json_str "$(prefix_meta "$name" bitness unknown)")" \
      "valid" "$(json_bool "$(prefix_is_valid "$name")")" \
      "path" "$(json_str "$(prefix_path "$name")")" \
      "size_bytes" "$(dir_size "$(prefix_path "$name")")")")
  done
  json_emit "home" "$(json_str "$(prefixes_dir)")" "prefixes" "$(json_array "${items[@]}")"
}

cmd_prefix_create() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix create needs a name"
  local raw=$name
  name=$(sanitize_name "$name")
  [[ -n $name ]] || die "'$raw' is not a usable name (letters, digits, dot, dash, underscore)"

  # Before doing the slow part, offer the update the user asked to be asked
  # about on boot.
  if [[ ${FLAG_no_update_check:-false} != true ]]; then
    offer_runner_update "$(flag FLAG_runner)"
  fi

  local arch; arch=$(flag FLAG_arch); arch=${arch:-win64}
  case $arch in
    win64 | win32 | both) ;;
    *) die "unknown architecture '$arch' (want win64, win32 or both)" ;;
  esac

  local runner; runner=$(prefix_resolve_runner "$(flag FLAG_runner)") || return 1
  ensure_dirs
  prefix_create "$name" "$runner" "$arch" "${FLAG_force:-false}" >/dev/null
}

cmd_prefix_remove() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix remove needs a name"
  prefix_remove "$name" "$ASSUME_YES"
}

cmd_prefix_info() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix info needs a name"
  [[ -d $(prefix_path "$name") ]] || die "no such installation: $name"

  local runner kind bitness dir
  runner=$(prefix_meta "$name" runner "-")
  kind=$(prefix_meta "$name" kind wine)
  bitness=$(prefix_meta "$name" bitness unknown)
  dir=$(prefix_wine_dir_resolved "$name")

  printf '\n%s%s%s\n\n' "$C_BOLD" "$name" "$C_RESET"
  ui_kv \
    "runner" "$runner ($(runner_meta "$runner" reported_version))" \
    "launch style" "$kind" \
    "architecture" "$bitness" \
    "requested" "$(prefix_meta "$name" requested "$(prefix_meta "$name" arch "-")")" \
    "created" "$(prefix_meta "$name" created_at unknown)" \
    "prefix" "$dir" \
    "size" "$(human_size "$(dir_size "$(prefix_path "$name")")")"

  printf '\n  %sprograms in drive_c%s\n' "$C_DIM" "$C_RESET"
  local exe found=false
  while IFS= read -r exe; do
    printf '    %s\n' "${exe#$dir/drive_c/}"
    found=true
  done < <(find "$dir/drive_c/Program Files" "$dir/drive_c/Program Files (x86)" \
    -maxdepth 3 -iname '*.exe' 2>/dev/null | sort | head -n15)
  [[ $found == true ]] || printf '    %s(nothing installed yet)%s\n' "$C_DIM" "$C_RESET"
  printf '\n'
}

cmd_prefix_path() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix path needs a name"
  printf '%s\n' "$(prefix_wine_dir_resolved "$name")"
}

cmd_prefix_run() {
  parse_args_until 1 "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix run needs an installation name"
  local -a cmd=("${POSITIONALS[@]:1}")
  [[ ${#cmd[@]} -gt 0 ]] || die "prefix run needs a program"

  # A broken prefix should say why and offer a fix, not fail with a stack of
  # Wine errors.
  if [[ ${FLAG_no_fix:-false} != true ]]; then
    prefix_offer_fixes "$name" || return 1
  fi

  prefix_run "$name" "${cmd[@]}"
}

