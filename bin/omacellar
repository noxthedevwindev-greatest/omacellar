  parse_args_until 1 "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix winetricks needs an installation name"
  local -a verbs=("${POSITIONALS[@]:1}")
  prefix_winetricks "$name" "${verbs[@]}"
}

cmd_prefix_env() {
  parse_args "$@"
  local name; name=$(first_positional)
  [[ -n $name ]] || die "prefix env needs an installation name"
  local runner; runner=$(prefix_meta "$name" runner)
  [[ -n $runner ]] || die "installation '$name' has no runner recorded"
